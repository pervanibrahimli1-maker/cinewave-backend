{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "server.js", "use": "@vercel/node" }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/server.js" },
    { "source": "/movie/:type/:id/:slug", "destination": "/movie-details.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
