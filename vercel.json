{
  "version": 2,
  "public": true,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/server.js" },
    { "source": "/movie/:type/:id/:slug", "destination": "/movie-details.html" },
    { "source": "/actor/:id/:slug", "destination": "/actor.html" },
    { "source": "/(.*)", "destination": "/$1" }
  ]
}
